<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
<meta name="theme-color" content="#000000">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Baixar o Lili</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com/3.4.17"></script>
<script>
  tailwind.config = {
    theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } }
  }
</script>
<style>
html, body {
  background: #000000;
  color: #f3f4f6;
  font-family: 'Inter', sans-serif;
  height: 100%;
  margin: 0;
}
.bg-layer {
  position: fixed;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: blur(10px) saturate(1.2) brightness(.4);
  transform: scale(1.3);
  z-index: 0;
}
.header-logo-o {
  display: inline-block;
  width: .75em;
  height: 1.09em;
  border-radius: .12em;
  background: linear-gradient(135deg, #facc15 0%, #fb923c 100%);
  margin: 0 .1em 0 0;
  vertical-align: -.2em;
  flex-shrink: 0;
}
.logo-lili {
  font-family: 'Nunito', ui-rounded, 'SF Pro Rounded', system-ui, sans-serif;
  font-weight: 800;
  letter-spacing: .02em;
  font-size: 4.5rem;
  line-height: 1;
  color: #fff;
}
@media (min-width: 640px) {
  .logo-lili { font-size: 5.5rem; }
}
.frosted-card {
  background: rgba(16, 16, 16, 0.72);
  -webkit-backdrop-filter: blur(24px) saturate(.85);
  backdrop-filter: blur(24px) saturate(.85);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  border-radius: 1rem;
}
.btn-gold-degrade {
  background: linear-gradient(90deg, #facc15 0%, #fbbf24 52%, #fb923c 100%);
  color: #000;
  font-weight: 700;
  transition: all 0.2s;
  border: 1px solid rgba(250, 204, 21, 0.4);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15), inset 0 1px 1px rgba(255, 255, 255, 0.3);
}
.btn-gold-degrade:hover {
  filter: brightness(1.1);
}
.btn-gold-degrade:active {
  transform: scale(.98);
}
.btn-gold-degrade:focus-visible {
  outline: 3px solid rgba(250, 204, 21, 0.5);
  outline-offset: 3px;
}
</style>
</head>
<body class="flex items-center justify-center p-4 relative select-none overflow-y-auto">

  <!-- Fundo -->
  <div id="bg-layer" class="bg-layer"></div>
  <div class="fixed inset-0 bg-gradient-to-t from-[#000000]/95 via-[#000000]/30 to-[#000000]/70 z-0 pointer-events-none"></div>

  <!-- Card principal -->
  <main class="frosted-card relative z-10 w-full max-w-md overflow-hidden px-6 py-12 sm:px-8 sm:py-14 my-auto text-center">

    <!-- Logo em destaque -->
    <h1 class="mb-8 flex justify-center">
      <span class="logo-lili"><span class="header-logo-o" aria-hidden="true"></span>Lili</span>
    </h1>

    <p class="mb-10 text-base font-medium text-gray-300 leading-relaxed">
      A experiência no Lili está melhor no aplicativo
    </p>

    <!-- Botão BAIXAR -->
    <button id="btnBaixar" type="button"
       class="btn-gold-degrade w-full py-4 rounded-lg text-sm uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span>Baixar</span>
    </button>

  </main>

  <script>
    // ============================================================
    // COLE AQUI O LINK DO APK EM BASE64
    // Para gerar: abra o console do navegador (F12) e rode:
    //   btoa("https://seusite.com/downloads/lili.apk")
    // Copie o resultado e cole entre as aspas abaixo.
    // ============================================================
    const APK_B64 = "";

    // O link só é montado no clique. Não existe href no botão.
    document.getElementById('btnBaixar').addEventListener('click', () => {
      if (!APK_B64) return;
      try {
        const a = document.createElement('a');
        a.href = atob(APK_B64);
        a.rel = 'noopener';
        a.download = '';
        document.body.appendChild(a);
        a.click();
        a.remove();
      } catch (e) {
        console.error(e);
      }
    });

    // Fundo
    const BG = "https://wallpaper.forfun.com/fetch/d1/d11b37523005f6dfe77d151ee2872b7c";
    document.getElementById('bg-layer').style.backgroundImage = `url('${BG}')`;
  </script>
</body>
</html>
.
